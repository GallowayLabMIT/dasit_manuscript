import pandas as pd
from pathlib import Path

pepfile: "inputs/metadata/metadata.yaml"
pepschema: "http://schema.databio.org/pep/2.1.0.yaml"

import csv
import itertools



def input_raw_alignments(wildcards):
    alignments = []
    for tup in pep.sample_table.itertuples():
        genome_name = tup.base_genome
        alignments.append(f"data/alignments/raw/{tup.Index}__{genome_name}.bam")
    return alignments

def input_rna_seq_quant(wildcards):
    quants = []
    for tup in pep.sample_table.itertuples():
        genome_name = tup.base_genome
        quants.append(f"data/salmon_quantification/{tup.Index}__{genome_name}")
    return quants

rule all:
    input:
        "data/deseq/GRCm39/"
        #"data/reports/multiqc_report.html"

##########################################################
# QC
##########################################################

def input_fastqc_reports(wildcards):
    """Return all expected FASTQC reports"""
    reports = []
    for tup in pep.sample_table.itertuples():
        for flowlane in range(len(tup.paired_fastq_base)):
            reports.extend([
                f"data/qc/pretrim_fastqc/{tup.Index}.flowlane{flowlane}/pretrim_{tup.Index}.flowlane{flowlane}.1_fastqc.html",
                f"data/qc/pretrim_fastqc/{tup.Index}.flowlane{flowlane}/pretrim_{tup.Index}.flowlane{flowlane}.2_fastqc.html",
                f"data/qc/posttrim_fastqc/{tup.Index}.flowlane{flowlane}/posttrim_{tup.Index}.flowlane{flowlane}.1_fastqc.html",
                f"data/qc/posttrim_fastqc/{tup.Index}.flowlane{flowlane}/posttrim_{tup.Index}.flowlane{flowlane}.2_fastqc.html",
            ])
    return reports

rule multiqc:
    input:
        input_fastqc_reports,
        "data/qc/duplicates/metrics_mqc.tsv",
        "data/qc/duplicates/full_metrics_mqc.tsv"
    output:
        "data/reports/multiqc_report.html"
    log:
        "data/logs/multiqc.log"
    conda:
        "envs/multiqc.yaml"
    shell:
        """
        rm -f {output:q}
        multiqc --force -o "data/reports" data/qc/pretrim_fastqc data/qc/posttrim_fastqc data/qc/duplicates >{log:q} 2>&1
        """

##########################################################
# helper functions for handling paired vs. unpaired reads
##########################################################
def is_paired(wildcards):
    return pep.sample_table.loc[wildcards.sample,"is_paired_reads"] == "True"



##########################################################
# Adapter trimming and initial QC
##########################################################
def input_raw_unpaired_fastqs(wildcards):
    """Locate input FASTQ files for unpaired samples"""
    return pep.sample_table.loc[wildcards.sample,'unpaired_fastq']

rule trim_unpaired_reads:
    input:
        input_raw_unpaired_fastqs
    output:
        trimmed='data/reads/trimmed/{sample}.unpaired.fastq.gz'
    params:
        outdir=subpath(output.trimmed, parent=True),
        prefname=subpath(output.trimmed, basename=True, strip_suffix=".unpaired.fastq.gz")
    conda:
        'envs/trim-galore.yaml'
    log:
        'data/logs/trim_reads/{sample}.log'
    # Note: from the trim_galore docs, with pgzip installed, cores=4 actually consumes ~15
    # https://github.com/FelixKrueger/TrimGalore/blob/master/Docs/Trim_Galore_User_Guide.md#full-list-of-options-for-trim-galore
    threads: 15
    resources:
        mem_mb=4096
    shell:
        """
        trim_galore --cores 4 --gzip --no_report_file --basename "{params.prefname}" --output_dir {params.outdir:q}  {input:q} > {log:q} 2>&1
        mv "data/reads/trimmed/{params.prefname}_trimmed.fq.gz" {output.trimmed:q}
        """

def input_raw_fastqs(wildcards):
    """Locate input FASTQ files for a specific flowlane (e.g. entry in the fastq subsample table)"""
    paired_fastq_base_vals = pep.sample_table.loc[wildcards.sample,"paired_fastq_base"]

    base_val = paired_fastq_base_vals[int(wildcards.flowlane)]

    return {"mate_1": f"{base_val}1_sequence.fastq.gz", "mate_2": f"{base_val}2_sequence.fastq.gz"}

rule trim_reads:
    input:
        unpack(input_raw_fastqs)
    output:
        mate_1='data/reads/trimmed/{sample}.flowlane{flowlane}.1.fastq.gz',
        mate_2='data/reads/trimmed/{sample}.flowlane{flowlane}.2.fastq.gz',
    params:
        outdir=subpath(output.mate_1, parent=True),
        prefname=subpath(output.mate_1, basename=True, strip_suffix=".1.fastq.gz")
    conda:
        'envs/trim-galore.yaml'
    log:
        'data/logs/trim_reads/{sample}.flowlane{flowlane}.log'
    # Note: from the trim_galore docs, with pgzip installed, cores=4 actually consumes ~15
    # https://github.com/FelixKrueger/TrimGalore/blob/master/Docs/Trim_Galore_User_Guide.md#full-list-of-options-for-trim-galore
    threads: 15
    resources:
        mem_mb=4096
    shell:
        """
        trim_galore --paired --cores 4 --gzip --no_report_file --basename "{params.prefname}" --output_dir {params.outdir:q}  {input.mate_1:q} {input.mate_2:q} > {log:q} 2>&1
        mv "data/reads/trimmed/{params.prefname}_val_1.fq.gz" {output.mate_1:q}
        mv "data/reads/trimmed/{params.prefname}_val_2.fq.gz" {output.mate_2:q}
        """
rule untrimmed_fastqc:
    input:
        unpack(input_raw_fastqs)
    output:
        report_1="data/qc/pretrim_fastqc/{sample}.flowlane{flowlane}/pretrim_{sample}.flowlane{flowlane}.1_fastqc.html",
        report_1_zip="data/qc/pretrim_fastqc/{sample}.flowlane{flowlane}/pretrim_{sample}.flowlane{flowlane}.1_fastqc.zip",
        report_2="data/qc/pretrim_fastqc/{sample}.flowlane{flowlane}/pretrim_{sample}.flowlane{flowlane}.2_fastqc.html",
        report_2_zip="data/qc/pretrim_fastqc/{sample}.flowlane{flowlane}/pretrim_{sample}.flowlane{flowlane}.2_fastqc.zip"
    params:
        outdir=subpath(output.report_1, parent=True)
    log:
        "data/logs/fastqc/pretrim_{sample}.flowlane{flowlane}.log"
    conda:
        "envs/fastqc.yaml"
    threads: 2
    resources:
        non_slurm_mem_mb=2048,
        mem_mb=(1024 + 512)
    shell:
        """
        fastqc --threads {threads} --memory {resources.non_slurm_mem_mb} --outdir "{params.outdir}" {input.mate_1:q} {input.mate_2:q} >"{log}" 2>&1
        ls "{params.outdir}" >> {log:q}
        mv "{params.outdir}/"*_1_sequence_fastqc.html {output.report_1:q}
        mv "{params.outdir}/"*_1_sequence_fastqc.zip {output.report_1_zip:q}
        mv "{params.outdir}/"*_2_sequence_fastqc.html {output.report_2:q}
        mv "{params.outdir}/"*_2_sequence_fastqc.zip {output.report_2_zip:q}
        """

rule trimmed_fastqc:
    input:
        mate_1='data/reads/trimmed/{sample}.flowlane{flowlane}.1.fastq.gz',
        mate_2='data/reads/trimmed/{sample}.flowlane{flowlane}.2.fastq.gz',
    output:
        report_1="data/qc/posttrim_fastqc/{sample}.flowlane{flowlane}/posttrim_{sample}.flowlane{flowlane}.1_fastqc.html",
        report_1_zip="data/qc/posttrim_fastqc/{sample}.flowlane{flowlane}/posttrim_{sample}.flowlane{flowlane}.1_fastqc.zip",
        report_2="data/qc/posttrim_fastqc/{sample}.flowlane{flowlane}/posttrim_{sample}.flowlane{flowlane}.2_fastqc.html",
        report_2_zip="data/qc/posttrim_fastqc/{sample}.flowlane{flowlane}/posttrim_{sample}.flowlane{flowlane}.2_fastqc.zip"
    params:
        outdir=subpath(output.report_1, parent=True)
    log:
        "data/logs/fastqc/posttrim_{sample}.flowlane{flowlane}.log"
    conda:
        "envs/fastqc.yaml"
    threads: 2
    resources:
        non_slurm_mem_mb=2048,
        mem_mb=(1024 + 512)
    shell:
        """
        fastqc --threads {threads} --memory {resources.non_slurm_mem_mb} --outdir "{params.outdir}" {input.mate_1:q} {input.mate_2:q} >"{log}" 2>&1
        ls "{params.outdir}" >> {log:q}
        mv "{params.outdir}/"*1_fastqc.html {output.report_1:q}
        mv "{params.outdir}/"*1_fastqc.zip {output.report_1_zip:q}
        mv "{params.outdir}/"*2_fastqc.html {output.report_2:q}
        mv "{params.outdir}/"*2_fastqc.zip {output.report_2_zip:q}
        """

##########################################################
# Alignment, merging, and filtering
##########################################################
rule align_unpaired_reads:
    input:
        reads='data/reads/trimmed/{sample}.unpaired.fastq.gz',
        indicies=multiext("data/genomes/{genome}/index", ".1.bt2", ".2.bt2", ".3.bt2", ".4.bt2", ".rev.1.bt2", ".rev.2.bt2")
    params:
        index_base = "data/genomes/{genome}"
    output:
        "data/alignments/raw/{sample}__{genome}.bam"
    log:
        "data/logs/alignment/{sample}__{genome}.log"
    conda:
        "envs/bowtie2.yaml"
    threads: 20
    resources:
        mem_mb=80000
    shell:
        """
        HEADER_LINE=$(cat {input.reads:q} | gunzip | head -n 1) ||:
        PU_FC=$(echo "$HEADER_LINE" | cut -d':' -f3)
        PU_lane=$(echo "$HEADER_LINE" | cut -d':' -f4)
        PU_barcode=$(echo "$HEADER_LINE" | cut -d':' -f10)
        PU="$PU_FC.$PU_lane.$PU_barcode"
        PL="ILLUMINA"
        RG="{wildcards.sample}.$PU"
        bowtie2 \
            --threads {threads} \
            -x "{params.index_base}/index" \
            -U {input.reads:q} \
            --reorder --local --very-sensitive-local \
            --rg-id "$RG" --rg "PU:$PU" --rg 'LB:{wildcards.sample}' --rg 'SM:{wildcards.sample}' --rg "PL:$PL" \
            --met-stderr --met 30 -t \
            2>'{log}' | sambamba view -S -f bam -o {output:q} /dev/stdin 2>/dev/null
        """

rule align_reads:
    input:
        mate_1='data/reads/trimmed/{sample}.flowlane{flowlane}.1.fastq.gz',
        mate_2='data/reads/trimmed/{sample}.flowlane{flowlane}.2.fastq.gz',
        indicies=multiext("data/genomes/{genome}/index", ".1.bt2", ".2.bt2", ".3.bt2", ".4.bt2", ".rev.1.bt2", ".rev.2.bt2")
    params:
        index_base = "data/genomes/{genome}"
    output:
        "data/alignments/raw/{sample}.flowlane{flowlane}__{genome}.bam"
    log:
        "data/logs/alignment/{sample}.flowlane{flowlane}__{genome}.log"
    conda:
        "envs/bowtie2.yaml"
    threads: 20
    resources:
        mem_mb=80000
    shell:
        """
        HEADER_LINE=$(cat {input.mate_1:q} | gunzip | head -n 1) ||:
        PU_FC=$(echo "$HEADER_LINE" | cut -d':' -f3)
        PU_lane=$(echo "$HEADER_LINE" | cut -d':' -f4)
        PU_barcode=$(echo "$HEADER_LINE" | cut -d':' -f10)
        PU="$PU_FC.$PU_lane.$PU_barcode"
        PL="ILLUMINA"
        RG="{wildcards.sample}.$PU"
        bowtie2 \
            --threads {threads} \
            -x "{params.index_base}/index" \
            -1 {input.mate_1:q} -2 {input.mate_2:q} \
            --reorder --local --very-sensitive-local \
            --rg-id "$RG" --rg "PU:$PU" --rg 'LB:{wildcards.sample}' --rg 'SM:{wildcards.sample}' --rg "PL:$PL" \
            --met-stderr --met 30 -t \
            2>'{log}' | sambamba view -S -f bam -o {output:q} /dev/stdin 2>/dev/null
        """
rule sort_bams:
    input:
        "data/alignments/raw/{bam}.bam"
    output:
        temp("data/alignments/sorted/{bam}.bam")
    conda:
        "envs/sambamba.yaml"
    threads: 4
    resources:
        mem_mb=1024*24
    shell:
        """
        sambamba sort --nthreads={threads} --memory-limit=20GiB --out={output:q} {input:q}
        """

def input_bams(wildcards):
    """Locate input BAM files for a specific sample to merge"""
    paired_fastq_base_vals = pep.sample_table.loc[wildcards.sample,"paired_fastq_base"]

    # We load N flowlanes for N the length of this base vals list 
    return [
        f"data/alignments/sorted/{wildcards.sample}.flowlane{i}__{wildcards.genome}.bam"
        for i in range(len(paired_fastq_base_vals))
    ]

rule merge_bams:
    input:
        input_bams
    output:
        "data/alignments/merged/{sample}__{genome}.bam"
    conda:
        "envs/sambamba.yaml"
    threads: 4
    params:
        n_bams=lambda wildcards, input: len(input)
    shell:
        """
        if [[ "{params.n_bams}" -eq 1 ]]; then
            cp {input:q} {output:q}
        else
            sambamba merge -t {threads} {output:q} {input:q}
        fi
        """
        
rule mark_duplicates:
    input:
        "data/alignments/merged/{sample}__{genome}.bam"
    output:
        bam="data/alignments/dedup_marked/{sample}__{genome}.bam",
        bai="data/alignments/dedup_marked/{sample}__{genome}.bam.bai",
        sbi="data/alignments/dedup_marked/{sample}__{genome}.bam.sbi",
        metrics="data/alignments/dedup_marked/{sample}__{genome}.metrics"
    log:
        "data/logs/mark_duplicates/{sample}__{genome}.log"
    conda:
        "envs/gatk4.yaml"
    threads: 16
    resources:
        mem_mb=1028*60
    shell:
        """
        gatk --java-options "-Xmx52G" MarkDuplicatesSpark \
            -I {input:q} -O {output.bam:q} -M {output.metrics:q} \
            --conf 'spark.executor.cores={threads}' >{log:q} 2>&1
        """

def input_dup_metrics(wildcards):
    base_genome_dups = []
    spikein_dups = []
    for tup in pep.sample_table.itertuples():
        genome_name = tup.base_genome
        if "genome_edits" in tup._fields:
            for edit in tup.genome_edits:
                genome_name = f"edited_{genome_name}_with_{edit}"
        base_genome_dups.append(f"data/alignments/dedup_marked/{tup.Index}__{genome_name}.metrics")
        if len(tup.spikein_genome) > 0:
            spikein_dups.append(f"data/alignments/dedup_marked/{tup.Index}__{tup.spikein_genome[0]}.metrics")
    return {'base_genome': base_genome_dups, 'spikein': spikein_dups}

rule collate_duplicate_metrics:
    input:
        unpack(input_dup_metrics)
    output:
        summary="data/qc/duplicates/metrics_mqc.tsv",
        metrics="data/qc/duplicates/full_metrics_mqc.tsv"
    log:
        "data/logs/collate_duplicates/collation.log"
    shell:
        """
        scripts/collate_duplicate_metrics.py --main-genome {input.base_genome:q} --spikein-genome {input.spikein:q} --general-stats-output {output.summary:q} --output {output.metrics:q} --log {log:q}
        """

rule select_suspicious_reads:
    input:
        "data/alignments/merged/{bam}.bam"
    output:
        "data/alignments/suspicious/{bam}.bam"
    conda:
        "envs/sambamba.yaml"
    threads: 4
    shell:
        r"""
        sambamba slice {input:q} "NC_000013.11:99812977-99838561" | \
        sambamba view \
            --format=bam \
            --filter="paired and not (unmapped or mate_is_unmapped or duplicate) and ((reverse_strand and mate_is_reverse_strand) or ((not reverse_strand) and (not mate_is_reverse_strand)))" \
            -o {output:q} \
            --nthreads {threads} /dev/stdin
        """

rule make_suspicious_bigwigs:
    input:
        bam="data/alignments/suspicious/{sample}__{genome}.bam",
        index="data/alignments/suspicious/{sample}__{genome}.bam.bai"
    output:
        "data/tracks/suspicious/{sample}__{genome}.bw"
    log:
        "data/logs/suspicious_bigwig/{sample}__{genome}.log"
    conda:
        "envs/deeptools.yaml"
    shell:
        """
        bamCoverage --bam {input.bam:q} --outFileFormat bigwig --outFileName {output:q} -v >{log:q} 2>&1
        """

rule plot_suspicious_roi_bigwigs:
    input:
        dox_minus="data/tracks/suspicious/{sample}_-dox__{genome}.bw",
        dox_plus="data/tracks/suspicious/{sample}_+dox__{genome}.bw",
        config="inputs/tracks/{config}.ini",
        roi="inputs/roi/{roi}.txt",
        genome_annots="data/genomes/{genome}/genomic_deduped_for_plotting.gff",
        bed="inputs/edit_beds/{genome}.bed"
    output:
        plot="data/plots/{sample}__{genome}/suspicious__{config}__{roi}.pdf",
        config_linked=temp("data/plots/links/suspicious__{sample}__{genome}__{config}_{roi}/tracks.ini"),
        annots_linked=temp("data/plots/links/suspicious__{sample}__{genome}__{config}_{roi}/genes.gff"),
        dox_minus_linked=temp("data/plots/links/suspicious__{sample}__{genome}__{config}_{roi}/seq_uninduced.bw"),
        dox_plus_linked=temp("data/plots/links/suspicious__{sample}__{genome}__{config}_{roi}/seq_induced.bw"),
        bed=temp("data/plots/links/suspicious__{sample}__{genome}__{config}_{roi}/edits.bed")
    params:
       linkdir=subpath(output.config_linked, parent=True) 
    log:
        "data/logs/plot_tracks/{sample}__{genome}/suspicious__{config}_{roi}.log"
    conda:
        "envs/pgt.yaml"
    shell:
        """
        ln -sf ../../../../{input.config:q} {output.config_linked:q}
        ln -sf ../../../../{input.genome_annots:q} {output.annots_linked:q}
        ln -sf ../../../../{input.bed:q} {output.bed:q}
        ln -sf ../../../../{input.dox_minus:q} {output.dox_minus_linked:q}
        ln -sf ../../../../{input.dox_plus:q} {output.dox_plus_linked:q}
        ROI=$(cat {input.roi:q})
        cd {params.linkdir}
        pyGenomeTracks --tracks tracks.ini -t "{wildcards.sample}-{wildcards.roi}" --region "$ROI" -o ../../../../{output.plot:q} >../../../../{log:q} 2>&1
        """


rule filter_bams:
    # samtools -b -q 2 -f 2 -F 1804
    input:
        "data/alignments/merged/{bam}.bam"
    output:
        "data/alignments/filtered/{bam}.bam"
    conda:
        "envs/sambamba.yaml"
    threads: 4
    shell:
        """
        sambamba view \
            --format=bam \
            --filter="mapping_quality >= 3 and proper_pair and (not (unmapped or mate_is_unmapped or duplicate))" \
            -o {output:q} {input:q} \
            --nthreads {threads}
        """

rule index_bam:
    # Index any bam in any alignments folder, as needed
    input:
        "data/alignments/{subfolder}/{bam}.bam"
    output:
        "data/alignments/{subfolder}/{bam}.bam.bai"
    log:
        "data/logs/index_bam/{subfolder}/{bam}.log"
    conda:
        "envs/sambamba.yaml"
    threads: 4
    shell:
        """
        sambamba index --nthreads={threads} {input:q} {output:q} >{log:q} 2>&1
        """

