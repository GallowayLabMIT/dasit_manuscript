        "data/summary/{sample}_fastqc/{sample}_2_fastqc.html"
    log:
        "data/logs/fastqc/{sample}.log"
    threads: 4
    resources:
        non_slurm_mem_mb=10000, #10k is the max
        mem_mb=11000
    shell:
        """
        fastqc --threads {threads} --memory {resources.non_slurm_mem_mb} --outdir "data/summary/{wildcards.sample}_fastqc" {input:q} >"{log}" 2>&1
        """
