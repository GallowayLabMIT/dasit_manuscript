##########################################################
# Spike-in normalization
##########################################################

def input_spikein_bam(wildcards):
    """Locate filtered spike-in BAM file for a sample"""
    spikein_genome = pep.sample_table.loc[wildcards.sample,"spikein_genome"][0]
    return f"data/alignments/filtered/{wildcards.sample}__{spikein_genome}.bam"

# https://github.com/deeptools/deepTools/issues/1073
rule compute_spike_in_scaling_factors:
    input:
        input_spikein_bam
    output:
        "data/statistics/spike-in-correction/{sample}.txt"
    log:
        "data/logs/spikein_scaling/{sample}.log"
    conda:
        "envs/sambamba.yaml"
    shell:
        """
        COUNTS=$(sambamba view -c {input:q})
        echo "10000 / $COUNTS" | bc -l > {output:q}
        """

rule make_normalized_bigwig:
    input:
        correction="data/statistics/spike-in-correction/{sample}.txt",
        bam="data/alignments/filtered/{sample}__{genome}.bam",
        index="data/alignments/filtered/{sample}__{genome}.bam.bai"
    output:
        "data/tracks/normalized/{sample}__{genome}.bw"
    log:
        "data/logs/normalized_bigwig/{sample}__{genome}.log"
    conda:
        "envs/deeptools.yaml"
    shell:
        """
        CORRECTION=$(cat {input.correction:q})
        bamCoverage --scaleFactor "$CORRECTION" --bam {input.bam:q} --outFileFormat bigwig --outFileName {output:q} -v >{log:q} 2>&1
        """

##########################################################
# Salmon quantification
##########################################################
rule download_transcriptome:
    input:
        genome_map="inputs/metadata/genome_map.csv",
        checksums="data/genomes/{assembly}/md5checksums.txt"
    conda:
        "envs/aria2.yaml"
    resources:
        runtime=60
    output:
        transcriptome="data/genomes/{assembly}/transcriptome.fna",
    wildcard_constraints:
        assembly="(?!edited_|ERCC).+"
    params:
        assembly_url=lambda wc, input:  query_csv(input.genome_map, "download_url", qcol="genome_shortname", qval=wc.assembly),
        assembly_name=lambda wc, input: query_csv(input.genome_map, "genome_fullname", qcol="genome_shortname", qval=wc.assembly)
    log:
        "data/logs/genomes/{assembly}/transcriptome_download.log"
    shell: 
        r"""
        aria2c -q "{params.assembly_url}/{params.assembly_name}_rna.fna.gz"  --log-level=info -l "{log}" -o "{output.transcriptome}.gz"
        echo "Computing checksums" >> "{log}"
        logpath=$(realpath "{log}")
        cd data/genomes/{wildcards.assembly}
        grep -E '{params.assembly_name}_(rna\.fna\.gz)' md5checksums.txt | sed 's/{params.assembly_name}_rna/transcriptome/g' | md5sum -c - >>"$logpath" 2>&1
        gunzip transcriptome.fna.gz
        """

rule compute_decoys:
    localrule: True
    input:
        genome="data/genomes/{assembly}/genomic.fna"
    output:
        decoys="data/genomes/{assembly}/rna_seq_decoys.txt"
    shell:
        r"""
        grep "^>" {input.genome:q} | cut -d " " -f 1 | sed -e 's/>//g' > {output.decoys:q}
        """

rule make_transcriptome_with_decoys:
    localrule: True
    input:
        transcriptome="data/genomes/{assembly}/transcriptome.fna",
        genome="data/genomes/{assembly}/genomic.fna"
    output:
        decoy_transcriptome="data/genomes/{assembly}/transcriptome_with_decoys.fa.gz"
    shell:
        r"""
        cat {input.transcriptome:q} {input.genome:q} | gzip -2 > {output.decoy_transcriptome:q}
        """

rule build_salmon_index:
    input:
        transcriptome="data/genomes/{genome}/transcriptome_with_decoys.fa.gz",
        decoys="data/genomes/{genome}/rna_seq_decoys.txt"
    output:
        directory("data/genomes/{genome}/salmon_index")
    log:
        "data/logs/genome_{genome}/build_salmon_index.log"
    conda:
        "envs/salmon.yaml"
    threads: 40
    resources:
        mem_mb=64*1024
    shell:
        """
        salmon index -t {input.transcriptome:q} -i {output:q} --decoys {input.decoys:q} -k 31 -p {threads} > {log:q} 2>&1
        """

def input_fastqs_salmon(wildcards):
    """Locate input FASTQ files to merge for salmon"""
    if is_paired(wildcards):
        
        paired_fastq_base_vals = pep.sample_table.loc[wildcards.sample,"paired_fastq_base"]

        # We load N flowlanes for N the length of this base vals list 
        return {
            'mate_1': [
                f"data/reads/trimmed/{wildcards.sample}.flowlane{i}.1.fastq.gz"
                for i in range(len(paired_fastq_base_vals))
            ],
            'mate_2': [
                f"data/reads/trimmed/{wildcards.sample}.flowlane{i}.2.fastq.gz"
                for i in range(len(paired_fastq_base_vals))
            ],
        }
    else: 
        return {
            'reads': f"data/reads/trimmed/{wildcards.sample}.unpaired.fastq.gz"
        }

rule salmon_quantification:
    input:
        unpack(input_fastqs_salmon),
        index="data/genomes/{genome}/salmon_index"
    output:
        quant="data/salmon_quantification/{sample}__{genome}/quant.sf"
    params:
        output_dir=subpath(output.quant, parent=True)
    log:
        "data/logs/salmon_quantification/{sample}__{genome}.log"
    conda:
        "envs/salmon.yaml"
    threads:10
    resources:
        mem_mb=24*1024
    run:
        if is_paired(wildcards):
            shell(
                """
                salmon quant -i {input.index} -l A \
                    -1 {input.mate_1:q} -2 {input.mate_2:q} \
                    --threads {threads} \
                    -o {params.output_dir} \
                    --validateMappings --gcBias \
                    > {log:q} 2>&1
                """
            )
        else:
            shell(
                """
                salmon quant -i {input.index} -l A \
                    -r {input.reads:q} \
                    --threads {threads} \
                    -o {params.output_dir} \
                    --validateMappings --gcBias \
                    > {log:q} 2>&1
                """
            )
