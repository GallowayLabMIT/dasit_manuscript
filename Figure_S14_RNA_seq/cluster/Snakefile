        """

##########################################################
# Genome download and modification
##########################################################

def query_csv(filename, out_col, *, qcol, qval):
    """Queries a CSV file, returning the (unique) query value / out column value"""
    # This could be done with a loop, but we'll use Pandas for easy sanity checks
    df = pd.read_csv(filename)
    df = df[df[qcol] == qval]
    if len(df) == 0:
        raise RuntimeError(f"Queried csv {filename} (query: {qcol}=='{qval}') has no results")
    if len(df) > 1:
        raise RuntimeError(f"Queried csv {filename} (query: {qcol}=='{qval}') has multiple results")
    return df[out_col].iloc[0]

rule copy_spikein_genomes:
    input:
        genome="inputs/spikein_genomes/{genome}.fna"
    output:
        genome="data/genomes/{genome}/genomic.fna"
    shell:
        r"""
        cp {input.genome:q} {output.genome:q}
        """

rule download_ncbi_genomes:
    input:
        genome_map="inputs/metadata/genome_map.csv"
    conda:
        "envs/aria2.yaml"
    resources:
        runtime=60
    output:
        genome="data/genomes/{assembly}/genomic.fna",
        gff_annotations="data/genomes/{assembly}/genomic.gff",
        gtf_annotations="data/genomes/{assembly}/genomic.gtf",
        assembly_report="data/genomes/{assembly}/assembly_report.txt",
        checksums="data/genomes/{assembly}/md5checksums.txt"
    wildcard_constraints:
        assembly="(?!edited_|ERCC).+"
    params:
        assembly_url=lambda wc, input:  query_csv(input.genome_map, "download_url", qcol="genome_shortname", qval=wc.assembly),
        assembly_name=lambda wc, input: query_csv(input.genome_map, "genome_fullname", qcol="genome_shortname", qval=wc.assembly)
    log:
        "data/logs/genomes/{assembly}/genome_download.log"
    shell: 
        r"""
        aria2c -q "{params.assembly_url}/{params.assembly_name}_genomic.fna.gz"  --log-level=info -l "{log}" -o "{output.genome}.gz"
        aria2c -q "{params.assembly_url}/{params.assembly_name}_genomic.gff.gz"  --log-level=info -l "{log}" -o "{output.gff_annotations}.gz"
        aria2c -q "{params.assembly_url}/{params.assembly_name}_genomic.gtf.gz"  --log-level=info -l "{log}" -o "{output.gtf_annotations}.gz"
        aria2c -q "{params.assembly_url}/{params.assembly_name}_assembly_report.txt"  --log-level=info -l "{log}" -o "{output.assembly_report}"
        aria2c -q "{params.assembly_url}/md5checksums.txt"  -l "{log}" -o "{output.checksums}"
        echo "Computing checksums" >> "{log}"
        logpath=$(realpath "{log}")
        cd data/genomes/{wildcards.assembly}
        grep -E '{params.assembly_name}_(assembly_report\.txt|genomic\.fna\.gz|genomic\.gtf\.gz|genomic\.gff\.gz)' md5checksums.txt | sed 's/{params.assembly_name}_//g' | md5sum -c - >>"$logpath" 2>&1
        gunzip *.gz
        """

        

rule generate_ncbi_chrom_sizes:
    localrule: True
    input:
        "data/genomes/{genome}/assembly_report.txt"
    output:
        "data/genomes/{genome}/chrom.sizes"
    resources:
        runtime=5
    shell:
        """
        sed '/#/d' "{input}" | grep '.*assembled-molecule.*Chromosome' | awk -F"\t" -v OFS="\t" '{{print $7, $9}}' > "{output}"
        """

rule generate_chrom_name_mapping:
    localrule: True
    input:
        "data/genomes/{genome}/assembly_report.txt"
    output:
        to_ucsc="data/genomes/{genome}/map_to_ucsc.tsv",
        from_ucsc="data/genomes/{genome}/map_from_ucsc.tsv"
    resources:
        runtime=5
    shell:
        """
        sed '/#/d' "{input}" | grep '.*assembled-molecule.*Chromosome' | awk -F"\t" -v OFS="\t" -v RS="\r\n" -v ORS="\n" '{{print $7, $10}}' > "{output.to_ucsc}"
        sed '/#/d' "{input}" | grep '.*assembled-molecule.*Chromosome' | awk -F"\t" -v OFS="\t" -v RS="\r\n" -v ORS="\n" '{{print $10, $7}}' > "{output.from_ucsc}"
        """

