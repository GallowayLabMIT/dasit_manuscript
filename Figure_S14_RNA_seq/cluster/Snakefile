rule generate_tx2gene:
    input: 
        annotations="data/genomes/{genome}/genomic.gtf"
    output:
        tx2gene="data/genomes/{genome}/tx2gene.tsv",
        gene_name_map="data/genomes/{genome}/gene_name_map.tsv"
    log:
        "data/logs/genomes/{genome}/generate_tx2gene.log"
    shell:
        "scripts/generate_tx2gene.py --annotations {input.annotations:q} --tx2gene {output.tx2gene:q} --gene-name-map {output.gene_name_map:q} >{log:q} 2>&1"

def input_salmon_quant_file(wildcards):
    samples = pep.sample_table
    samples = samples[samples.base_genome == wildcards.genome]
    quants = []
    for tup in samples.itertuples():
        genome_name = tup.base_genome
        quants.append(f"data/salmon_quantification/{tup.Index}__{genome_name}/quant.sf")
    return quants

def make_deseq_metadata_csv(csv_file_name, wildcards):
    samples = pep.sample_table
    samples = samples[samples.base_genome == wildcards.genome]
    with open(csv_file_name, 'w') as f:
        writer = csv.DictWriter(f, fieldnames=["salmon_quant_file", "sample_name"]+samples.columns.tolist())
        writer.writeheader()
        for tup in samples.itertuples():
            genome_name = tup.base_genome
            salmon_quant_file = f"data/salmon_quantification/{tup.Index}__{genome_name}/quant.sf"
            sample_dict = tup._asdict()
            sample_dict["sample_name"] = sample_dict["Index"]
            del sample_dict["Index"]
            sample_dict["salmon_quant_file"] = salmon_quant_file
            writer.writerow(sample_dict)

rule deseq_analysis:
    input:
        tx2gene="data/genomes/{genome}/tx2gene.tsv",
        samples=input_salmon_quant_file,
        analysis_yaml="inputs/metadata/analysis.yaml"
    output:
        output_dir=directory("data/deseq/{genome}/"),
        metadata="data/deseq/{genome}/deseq2_metadata.csv"
    log:
        "data/logs/deseq/{genome}/deseq_analysis.log"
    conda:
        "envs/deseq2.yaml"
    threads: 4
    resources:
        mem_mb=1024*24  
    run:
        make_deseq_metadata_csv(output.metadata, wildcards)

        shell(
        """
        scripts/deseq.R --tx2gene {input.tx2gene:q} --sample-metadata {output.metadata:q} --analysis-yaml {input.analysis_yaml:q} --output-dir {output.output_dir:q} >{log:q} 2>&1
        """)
        

